<?xml version="1.0" encoding="utf-8"?>
<!-- System cloud backup is disabled by allowBackup=false in this fork. Keep the media rule
     for compatibility, and prevent a device transfer from opting the new phone into reads. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="opengym-media/" />
    </cloud-backup>
    <device-transfer>
        <!-- Permissions and opt-in belong to this phone, even when its data is transferred. -->
        <exclude domain="file" path="opengym-steps.json" />
    </device-transfer>
</data-extraction-rules>
